				<level>1</level>
				<order>1</order>
				<psyfocusCost>0.03</psyfocusCost>
				<entropyGain>50</entropyGain>
				<!-- <prerequisites> -->
				<!-- <li>VPE_Neurophage_NeuralString_STNL</li> -->
				<!-- </prerequisites> -->
